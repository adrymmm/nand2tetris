/// This file is part of www.nand2tetris.org
// and the book "The Elements of Computing Systems"
// by Nisan and Schocken, MIT Press.
// File name: projects/2/ALU.hdl
/**
 * ALU (Arithmetic Logic Unit):
 * Computes out = one of the following functions:
 *                0, 1, -1,
 *                x, y, !x, !y, -x, -y,
 *                x + 1, y + 1, x - 1, y - 1,
 *                x + y, x - y, y - x,
 *                x & y, x | y
 * on the 16-bit inputs x, y,
 * according to the input bits zx, nx, zy, ny, f, no.
 * In addition, computes the two output bits:
 * if (out == 0) zr = 1, else zr = 0
 * if (out < 0)  ng = 1, else ng = 0
 */
// Implementation: Manipulates the x and y inputs
// and operates on the resulting values, as follows:
// if (zx == 1) sets x = 0        // 16-bit constant
// if (nx == 1) sets x = !x       // bitwise not
// if (zy == 1) sets y = 0        // 16-bit constant
// if (ny == 1) sets y = !y       // bitwise not
// if (f == 1)  sets out = x + y  // integer 2's complement addition
// if (f == 0)  sets out = x & y  // bitwise and
// if (no == 1) sets out = !out   // bitwise not

// Own implementation of 16-bit inverter
CHIP ALU {
    IN  
        x[16], y[16],  // 16-bit inputs        
        zx, // zero the x input?
        nx, // negate the x input?
        zy, // zero the y input?
        ny, // negate the y input?
        f,  // compute (out = x + y) or (out = x & y)?
        no; // negate the out output?
    OUT 
        out[16], // 16-bit output
        zr,      // if (out == 0) equals 1, else 0
        ng;      // if (out < 0)  equals 1, else 0

    PARTS:
    /// X BLOCK
    // Zero x
    Mux16(a=x, b[0..15]=false, sel=zx, out=zxout);
    // Bitwise negation
    Not16(in=zxout, out=flipx);
    // Return bitwise negation when nx
    Mux16(a=zxout, b=flipx, sel=nx, out=nxout);

    /// Y BLOCK
    // Zero y
    Mux16(a=y, b[0..15]=false, sel=zy, out=zyout);
    // Bitwise negation
    Not16(in=zyout, out=flipy);
    // Return bitwise negation
    Mux16(a=zyout, b=flipy, sel=ny, out=nyout);

    // BITWISE ADDITION
    Add16(a=nxout, b=nyout, out=xaddy);

    // BITWISE AND
    And16(a=nxout, b=nyout, out=xandy);

    // Impose addition or bitwise and
    Mux16(a=xandy, b=xaddy, sel=f, out=fout);

    // Negate output conditional on no
    Not16(in=fout, out=nfout);
    // Last bit defines if negative or positive
    // Saving 8-bit slices for Or8Way
    Mux16(a=fout, b=nfout, sel=no, out=out, out[15]=ng,
    out[0..7]=lsb, out[8..15]=msb);

    // Testing for zero
    Or8Way(in=lsb, out=o1);
    Or8Way(in=msb, out=o2);
    Or(a=o1, b=o2, out=nzr);
    Not(in=nzr, out=zr);
}